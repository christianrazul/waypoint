{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "sticky",
  "description": "Agenda sticky: reads and edits the agenda inline, updates checklist, navigates sections, and sizes only its own window.",
  "windows": [
    "sticky"
  ],
  "platforms": [
    "macOS",
    "windows"
  ],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "allow-get-agenda-state",
    "allow-set-agenda-item-done",
    "allow-navigate-agenda",
    "allow-resize-sticky",
    "allow-get-sticky-size",
    "allow-begin-sticky-resize",
    "allow-resize-sticky-to",
    "allow-end-sticky-resize",
    "allow-reset-sticky-size",
    "allow-start-sticky-drag",
    "allow-edit-agenda",
    "allow-begin-sticky-edit",
    "allow-end-sticky-edit",
    "allow-open-setup",
    "allow-request-setup-close",
    "allow-get-shortcuts"
  ]
}
