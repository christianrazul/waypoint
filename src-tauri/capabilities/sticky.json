{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "sticky",
  "description": "Agenda sticky: reads agenda, updates checklist, navigates sections, and sizes only its own window.",
  "windows": [
    "sticky"
  ],
  "platforms": [
    "macOS",
    "windows"
  ],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "allow-get-agenda-state",
    "allow-set-agenda-item-done",
    "allow-navigate-agenda",
    "allow-resize-sticky",
    "allow-start-sticky-drag",
    "allow-open-setup",
    "allow-request-setup-close",
    "allow-get-shortcuts"
  ]
}
