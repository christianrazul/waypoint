{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "hotbar",
  "description": "Hotbar: drawing controls, color picker, and grip dragging. Persistence remains native.",
  "windows": [
    "hotbar"
  ],
  "platforms": [
    "macOS",
    "windows"
  ],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "core:window:allow-start-dragging",
    "allow-get-drawing-state",
    "allow-set-color",
    "allow-clear-annotations",
    "allow-close-hotbar",
    "allow-set-picker-open",
    "allow-select-tool",
    "allow-get-features",
    "allow-begin-sampling",
    "allow-end-sampling",
    "allow-sample-color"
  ]
}
