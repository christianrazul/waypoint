{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "setup",
  "description": "Agenda editor and sticky appearance controls; keyboard focus is managed natively.",
  "windows": [
    "setup"
  ],
  "platforms": [
    "macOS",
    "windows"
  ],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "allow-get-agenda-state",
    "allow-edit-agenda",
    "allow-open-setup",
    "allow-close-setup",
    "allow-get-shortcuts",
    "allow-set-shortcut",
    "allow-record-shortcut"
  ]
}
