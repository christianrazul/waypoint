{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "overlay",
  "description": "Annotation canvas: listens for drawing and history events; can acquire/release keyboard focus only for text editing.",
  "windows": [
    "overlay-*"
  ],
  "platforms": [
    "macOS",
    "windows"
  ],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "allow-get-drawing-state",
    "allow-begin-text-edit",
    "allow-end-text-edit",
    "allow-request-setup-close",
    "allow-get-overlay-session",
    "allow-save-overlay-session",
    "allow-overlay-session-ready"
  ]
}
